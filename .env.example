# Copy to .env for local work. Never commit .env.
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG is not 1. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Set to 1 if a reverse proxy terminates HTTPS and sends X-Forwarded-Proto
DJANGO_BEHIND_PROXY=0
# Persistent locations on your host (optional)
# DJANGO_DB_PATH=/var/data/db.sqlite3
# DJANGO_MEDIA_ROOT=/var/data/media
# DJANGO_SERVE_MEDIA=1

# Contact form notification (optional; messages are always stored in the admin)
CONTACT_NOTIFY_EMAIL=
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
